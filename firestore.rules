rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if user is authenticated
    function isAuth() {
      return request.auth != null;
    }

    // Helper: get user role from /users/{uid}. Missing profile => non-privileged.
    function userRole() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'employee')
        : 'employee';
    }

    function isEmployer() {
      return isAuth() && (userRole() == 'employer' || userRole() == 'admin');
    }

    function isEmployee() {
      return isAuth() && (userRole() == 'employee' || userRole() == 'viewer');
    }

    function userEmployeeId() {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return userDoc.exists ? userDoc.data.employeeId : null;
    }

    function isEmployeeOwner(employeeId) {
      return isEmployee() && userEmployeeId() == employeeId;
    }

    function canReadEmployee(employeeId) {
      return isAuth() && (
        isEmployeeOwner(employeeId) ||
        get(/databases/$(database)/documents/employees/$(employeeId)).data.employerId == request.auth.uid
      );
    }

    function canSignPayment(employeeId) {
      return isEmployeeOwner(employeeId)
        && resource.data.signed != true
        && request.resource.data.signed == true
        && request.resource.data.signedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'signed',
          'employeeSignatureUrl',
          'signedAt',
          'signedBy',
          'updatedAt'
        ]);
    }

    // Financial + signature fields that must not change once a payment is signed.
    function signedLockedKeys() {
      return [
        'baseSalary', 'pocketMoney', 'shabbatAmount', 'vacationAmount', 'holidayAmount',
        'grossTotal', 'cashPaid', 'payslipPaid', 'bankTransferPaid', 'totalPaid',
        'balanceDue', 'paymentStatus', 'month', 'year',
        'signed', 'employeeSignatureUrl', 'signedAt', 'signedBy'
      ];
    }

    // Users collection - allow new users to create their profile
    match /users/{userId} {
      allow read: if isAuth() && request.auth.uid == userId;
      allow create: if isAuth() && request.auth.uid == userId;
      // A user may update their own profile but can never change their own role
      // (no self-promotion to employer).
      allow update: if isAuth() && request.auth.uid == userId
                    && request.resource.data.role == resource.data.role;
      allow delete: if isAuth() && request.auth.uid == userId;
    }

    // Employers collection
    match /employers/{employerId} {
      allow read: if isAuth() && resource.data.createdBy == request.auth.uid;
      allow create: if isEmployer();
      allow update, delete: if resource.data.createdBy == request.auth.uid;
    }

    // Employees collection
    match /employees/{employeeId} {
      allow read: if canReadEmployee(employeeId);
      allow create: if isAuth() && request.resource.data.employerId == request.auth.uid;
      allow update: if isAuth()
                    && resource.data.employerId == request.auth.uid
                    && request.resource.data.employerId == resource.data.employerId;
      allow delete: if resource.data.employerId == request.auth.uid;

      // Year settings
      match /years/{year} {
        allow read: if canReadEmployee(employeeId);
        allow write: if canReadEmployee(employeeId) && isEmployer();

        // Monthly payments
        match /monthlyPayments/{month} {
          allow read: if canReadEmployee(employeeId);
          allow create: if canReadEmployee(employeeId) && isEmployer();
          allow delete: if canReadEmployee(employeeId) && isEmployer()
                        && resource.data.signed != true;
          // Employer may edit only while unsigned, or touch non-locked fields
          // (e.g. attachments/notes) after signing. The employee may sign once.
          allow update: if (
                          canReadEmployee(employeeId) && isEmployer() && (
                            resource.data.signed != true ||
                            !request.resource.data.diff(resource.data).affectedKeys().hasAny(signedLockedKeys())
                          )
                        ) || canSignPayment(employeeId);
        }

        // Pension payments
        match /pensionPayments/{month} {
          allow read: if canReadEmployee(employeeId);
          allow write: if canReadEmployee(employeeId) && isEmployer();
        }
      }

      // Audit log – append only for auth users, read only for employer/admin
      match /auditLog/{logId} {
        allow read: if canReadEmployee(employeeId);
        allow create: if canReadEmployee(employeeId);
        allow update, delete: if false; // immutable
      }
    }
  }
}
