rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if user is authenticated
    function isAuth() {
      return request.auth != null;
    }

    // Helper: get user role from /users/{uid}. Missing profile => non-privileged.
    function userRole() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'caregiver') == 'employer' ? 'admin' : get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'caregiver') == 'employee' ? 'caregiver' : get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'caregiver'))
        : 'caregiver';
    }

    function isAdmin() {
      return isAuth() && userRole() == 'admin';
    }

    function isCaregiver() {
      return isAuth() && userRole() == 'caregiver';
    }

    function userEmployeeId() {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return userDoc.exists ? userDoc.data.employeeId : null;
    }

    function isEmployeeOwner(employeeId) {
      return isCaregiver() && userEmployeeId() == employeeId;
    }

    function canReadEmployee(employeeId) {
      return isAuth() && (
        isAdmin() ||
        isEmployeeOwner(employeeId) ||
        get(/databases/$(database)/documents/employees/$(employeeId)).data.employerId == request.auth.uid
      );
    }

    function canSignPayment(employeeId) {
      return isEmployeeOwner(employeeId)
        && resource.data.signed != true
        && request.resource.data.signed == true
        && request.resource.data.signedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'signed',
          'employeeSignatureUrl',
          'signedAt',
          'signedBy',
          'updatedAt'
        ]);
    }

    // Financial + signature fields that must not change once a payment is signed.
    function signedLockedKeys() {
      return [
        'baseSalary', 'pocketMoney', 'shabbatAmount', 'vacationAmount', 'holidayAmount',
        'grossTotal', 'cashPaid', 'payslipPaid', 'bankTransferPaid', 'totalPaid',
        'balanceDue', 'paymentStatus', 'month', 'year',
        'signed', 'employeeSignatureUrl', 'signedAt', 'signedBy'
      ];
    }

    // Users collection - allow new users to create their profile
    match /users/{userId} {
      allow read: if isAuth() && (request.auth.uid == userId || isAdmin());
      allow create: if isAdmin() || (isAuth() && request.auth.uid == userId && request.resource.data.role == 'caregiver');
      allow update: if isAdmin() || (isAuth() && request.auth.uid == userId
                    && request.resource.data.role == resource.data.role
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'preferredLanguage', 'defaultLanguage', 'active']));
      allow delete: if isAdmin() && request.auth.uid != userId;
    }

    match /usernameMappings/{usernameNormalized} {
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if isAdmin();
    }

    // Employers collection
    match /employers/{employerId} {
      allow read: if isAuth() && resource.data.createdBy == request.auth.uid;
      allow create: if isAdmin();
      allow update, delete: if resource.data.createdBy == request.auth.uid;
    }

    // Employees collection
    match /employees/{employeeId} {
      allow read: if canReadEmployee(employeeId);
      allow create: if isAdmin() && request.resource.data.employerId == request.auth.uid;
      allow update: if isAdmin()
                    && resource.data.employerId == request.auth.uid
                    && request.resource.data.employerId == resource.data.employerId;
      allow delete: if isAdmin() && resource.data.employerId == request.auth.uid;

      // Year settings
      match /years/{year} {
        allow read: if canReadEmployee(employeeId);
        allow write: if canReadEmployee(employeeId) && isAdmin();

        // Monthly payments
        match /monthlyPayments/{month} {
          allow read: if canReadEmployee(employeeId);
          allow create: if canReadEmployee(employeeId) && isAdmin();
          allow delete: if canReadEmployee(employeeId) && isAdmin()
                        && resource.data.signed != true;
          // Employer may edit only while unsigned, or touch non-locked fields
          // (e.g. attachments/notes) after signing. The employee may sign once.
          allow update: if (
                          canReadEmployee(employeeId) && isAdmin() && (
                            resource.data.signed != true ||
                            !request.resource.data.diff(resource.data).affectedKeys().hasAny(signedLockedKeys())
                          )
                        ) || canSignPayment(employeeId);
        }

        // Pension payments
        match /pensionPayments/{month} {
          allow read: if canReadEmployee(employeeId);
          allow write: if canReadEmployee(employeeId) && isAdmin();
        }
      }

      // Audit log – append only for auth users, read only for employer/admin
      match /auditLog/{logId} {
        allow read: if canReadEmployee(employeeId);
        allow create: if canReadEmployee(employeeId);
        allow update, delete: if false; // immutable
      }
    }
  }
}
